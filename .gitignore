# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
terraform.tfvars
terraform.tfvars.*
!terraform.tfvars.example

# secrets
*.secret
*.key
*.pem

# environment
.env*
!.env.example

# editor and backup copies — these shadow whatever file they were made from,
# so a backup of .env or terraform.tfvars would otherwise be committable
*~
*.bak
*.orig

# OS
.DS_Store

# Python
__pycache__/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Editor autosaves whose names start with '#' (emacs writes #file#). Escaped, because
# an unescaped '#' would start a comment. These hold a verbatim copy of a file that may
# itself be ignored — an autosave of .env.<env> carries the same secrets — so the ignore
# has to cover the autosave, not just the original. Emacs LOCK files are named .#file and
# start with a dot, so this pattern does not match them.
\#*
