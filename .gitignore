# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
terraform.tfvars
terraform.tfvars.*
!terraform.tfvars.example

# secrets
*.secret
*.key
*.pem

# environment
.env*
!.env.example

# editor and backup copies — these shadow whatever file they were made from,
# so a backup of .env or terraform.tfvars would otherwise be committable
*~
*.bak
*.orig

# OS
.DS_Store

# Python
__pycache__/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
