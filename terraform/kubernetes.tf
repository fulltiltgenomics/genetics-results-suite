resource "kubernetes_namespace_v1" "genetics" {
  metadata {
    name = var.namespace
  }

  depends_on = [google_container_node_pool.primary_nodes]
}

resource "kubernetes_service_account_v1" "genetics_suite" {
  metadata {
    name      = "genetics-suite"
    namespace = kubernetes_namespace_v1.genetics.metadata[0].name

    annotations = var.manage_iam ? {
      "iam.gke.io/gcp-service-account" = google_service_account.genetics_suite[0].email
    } : {}
  }
}

# chat-backend's access-grant reconciler rewrites oauth2-proxy's authenticated-emails file so
# an admin can admit an address without a deploy (genetics-mcp-server access_grants.py). The
# ConfigMap itself is generated by deploy.sh, so it is named here rather than managed here.
# Scoped to that one object and to get/patch: the KSA is shared with mcp-server, db-api,
# rag-service and the cronjobs, so this is also what any of them could do with the token —
# add an address to the gateway allow-list, which a holder of INTERNAL_API_SECRET could in
# effect already do by writing the grant table through chat-backend.
resource "kubernetes_role_v1" "access_grant_allowlist" {
  metadata {
    name      = "access-grant-allowlist"
    namespace = kubernetes_namespace_v1.genetics.metadata[0].name
  }

  rule {
    api_groups     = [""]
    resources      = ["configmaps"]
    resource_names = ["oauth2-allowed-emails"]
    verbs          = ["get", "patch"]
  }
}

resource "kubernetes_role_binding_v1" "access_grant_allowlist" {
  metadata {
    name      = "access-grant-allowlist"
    namespace = kubernetes_namespace_v1.genetics.metadata[0].name
  }

  role_ref {
    api_group = "rbac.authorization.k8s.io"
    kind      = "Role"
    name      = kubernetes_role_v1.access_grant_allowlist.metadata[0].name
  }

  subject {
    kind      = "ServiceAccount"
    name      = kubernetes_service_account_v1.genetics_suite.metadata[0].name
    namespace = kubernetes_namespace_v1.genetics.metadata[0].name
  }
}
