project_id           = "your-gcp-project-id"
region               = "europe-west1"
zone                 = "europe-west1-b"
cluster_name         = "finngenie"
namespace            = "genetics"
manage_iam           = false
node_service_account = "some-account@somewhere.gserviceaccount.com"
static_ip_name       = "finngenie-ip"
domains              = ["finngenie.finngen.fi", "finngenie.fi"]
config_profile       = "finngen"
oauth_email_domain   = "finngen.fi"          # comma-separated for several, e.g. "broadinstitute.org,finngen.fi"
oauth_allowed_emails = ""                     # extra specific addresses, e.g. "a@apple.com,b@me.com,c@privaterelay.appleid.com"
app_name             = "FinnGenie" # product/brand name shown in UI and assistant persona (e.g. "GeneGenie" for daly)
machine_type         = "e2-standard-4"
# Pin these equal. A full deploy.sh surges every RollingUpdate deployment by one pod, which
# overshoots a single e2-standard-4; with min < max the autoscaler adds a node for the rollout
# and reaps it ~15 min later, evicting whatever was scheduled onto it mid-request. Two
# e2-standard-4 nodes fit the surge. See "Node pool sizing" in docs/project-spec.md.
min_node_count = 2
max_node_count = 2
enable_log_sinks = false

# Only needed when this deployment shares a GCP PROJECT with another one (as daly-staging does
# with daly). Suffixes the project-scoped resource names that would otherwise collide: the
# Artifact Registry repo, the Workload Identity service account, the chat-data snapshot policy,
# the Keycloak backup bucket, and the log sinks with their BigQuery datasets. Leave empty for
# the first/only deployment in a project — changing it later renames (recreates) those
# resources. Cluster-scoped names already derive from cluster_name.
# resource_suffix = "-staging"

# Node label only. Cosmetic.
# environment = "staging"

# VPC ranges. Defaults shown; two deployments in one project get separate VPCs, so these may
# overlap safely — set them apart anyway if the networks might ever be peered.
# subnet_cidr   = "10.0.0.0/20"
# pods_cidr     = "10.16.0.0/14"
# services_cidr = "10.20.0.0/20"
