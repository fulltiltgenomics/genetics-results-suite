project_id           = "your-gcp-project-id"
region               = "europe-west1"
zone                 = "europe-west1-b"
cluster_name         = "finngenie"
namespace            = "genetics"
manage_iam           = false
node_service_account = "some-account@somewhere.gserviceaccount.com"
static_ip_name       = "finngenie-ip"
domains              = ["finngenie.finngen.fi", "finngenie.fi"]
config_profile       = "finngen"
oauth_email_domain   = "finngen.fi"          # comma-separated for several, e.g. "broadinstitute.org,finngen.fi"
oauth_allowed_emails = ""                     # extra specific addresses, e.g. "a@apple.com,b@me.com,c@privaterelay.appleid.com"
app_name             = "FinnGenie" # product/brand name shown in UI and assistant persona (e.g. "GeneGenie" for daly)
machine_type         = "e2-standard-4"
# The pool autoscales. A full deploy.sh surges every RollingUpdate deployment by one pod,
# which can overshoot a single e2-standard-4, so the autoscaler adds a node for the rollout
# and reaps it ~15 min later. The PodDisruptionBudgets in k8s/disruption-budgets/ stop that
# scale-down from evicting chat-backend or results-api. See "Node pool sizing" in
# docs/project-spec.md before changing these.
min_node_count = 1
max_node_count = 3
