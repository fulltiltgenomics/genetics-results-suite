project_id           = "your-gcp-project-id"
region               = "europe-west1"
zone                 = "europe-west1-b"
cluster_name         = "finngenie"

# REQUIRED by scripts/rollout.sh. The kubectl context name of THIS deployment's cluster, exactly
# as `kubectl config get-contexts -o name` prints it. rollout.sh refuses to touch a cluster whose
# current context is not this string, and refuses outright when the key is missing, set twice,
# indented, or not a plain quoted string — it is stated here rather than derived from project_id,
# zone and cluster_name because every derivation that was tried failed towards terraform's
# defaults, which name a PRODUCTION cluster in both projects. No terraform resource reads it.
kube_context         = "gke_your-gcp-project-id_europe-west1-b_finngenie"

namespace            = "genetics"
manage_iam           = false
node_service_account = "some-account@somewhere.gserviceaccount.com"
static_ip_name       = "finngenie-ip"
domains              = ["finngenie.finngen.fi", "finngenie.fi"]
config_profile       = "finngen"
oauth_email_domain   = "finngen.fi"          # comma-separated for several, e.g. "broadinstitute.org,finngen.fi"
oauth_allowed_emails = ""                     # extra specific addresses, e.g. "a@apple.com,b@me.com,c@privaterelay.appleid.com"
app_name             = "FinnGenie" # product/brand name shown in UI and assistant persona (e.g. "GeneGenie" for daly)
machine_type         = "e2-standard-4"
# The pool autoscales. A full deploy.sh surges every RollingUpdate deployment by one pod,
# which can overshoot a single e2-standard-4, so the autoscaler adds a node for the rollout
# and reaps it ~15 min later. The PodDisruptionBudgets in k8s/disruption-budgets/ stop that
# scale-down from evicting chat-backend or results-api. See "Node pool sizing" in
# docs/project-spec.md before changing these.
min_node_count = 1
max_node_count = 3

# Dedicated gVisor pool for the code-execution sandbox. OFF by default: scripts/deploy.sh
# runs `terraform apply -auto-approve` on every full deploy, so an ungated pool would appear
# on a routine deploy nobody opted into. Set sandbox_pool_enabled = true to create it.
# Pinned at one node in terraform (min == max == 1, not a variable) and separate from the
# pool above, so it adds nothing to the surge budget — it is a standing cost of one small
# node instead.
# When enabled, sandbox_node_service_account is REQUIRED: a dedicated GSA in THIS project
# with only roles/logging.logWriter, roles/monitoring.metricWriter, roles/monitoring.viewer,
# roles/stackdriver.resourceMetadata.writer, roles/artifactregistry.reader. Never
# genetics-suite, never node_service_account, never the Compute Engine default. Terraform
# checks the email's shape and those two identities — it does not create the SA and does not
# verify which roles it actually holds.
sandbox_pool_enabled = false
sandbox_machine_type = "e2-standard-2"
# sandbox_node_service_account = "finngenie-sandbox-node@your-gcp-project-id.iam.gserviceaccount.com"

enable_log_sinks = false

# Only needed when this deployment shares a GCP PROJECT with another one (as daly-staging does
# with daly). Suffixes the project-scoped resource names that would otherwise collide: the
# Artifact Registry repo, the Workload Identity service account, the chat-data snapshot policy,
# the Keycloak backup bucket, and the log sinks with their BigQuery datasets. Leave empty for
# the first/only deployment in a project — changing it later renames (recreates) those
# resources. Cluster-scoped names already derive from cluster_name.
# resource_suffix = "-staging"

# Node label only. Cosmetic.
# environment = "staging"

# VPC ranges. Defaults shown; two deployments in one project get separate VPCs, so these may
# overlap safely — set them apart anyway if the networks might ever be peered.
# subnet_cidr   = "10.0.0.0/20"
# pods_cidr     = "10.16.0.0/14"
# services_cidr = "10.20.0.0/20"
